# ---------------------------------------------------------------------------
# LORDGYM — variables de entorno
# ---------------------------------------------------------------------------
# Sin ninguna variable configurada la app arranca en MODO LOCAL: persistencia en
# disco (.lordgym-data/db.json) con datos demo sembrados. Todo funciona.
#
# En Vercel (o cualquier serverless) hace falta una base de datos de verdad,
# porque el disco es de solo lectura y se borra entre peticiones.
# ---------------------------------------------------------------------------

# Clave usada para firmar las cookies de sesión. OBLIGATORIA en producción.
LORDGYM_SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Sembrar el equipo de demostración la primera vez (true por defecto).
# Con "false" sólo se carga la biblioteca de ejercicios y las pruebas físicas.
LORDGYM_SEED_DEMO=true

# --- PostgreSQL: Neon, Vercel Postgres, servidor propio (recomendado) ------
# Con esto basta. LORDGYM detecta la cadena de conexión sola, crea el esquema
# en el primer arranque y siembra la biblioteca. No hay que ejecutar ningún SQL.
# La integración de Neon/Vercel Storage inyecta DATABASE_URL automáticamente.
DATABASE_URL=

# También se aceptan POSTGRES_URL y POSTGRES_PRISMA_URL (los que crea Vercel),
# y LORDGYM_DATABASE_URL si quieres una distinta de la del resto del proyecto.

# Opcionales:
#   LORDGYM_PG_POOL_MAX=3          conexiones por instancia (3 por defecto)
#   LORDGYM_PG_SSL_NO_VERIFY=1     sólo para certificados autofirmados

# --- Alternativa: Supabase -------------------------------------------------
# Sólo si prefieres su API REST en lugar de una conexión PostgreSQL directa.
# Requiere ejecutar supabase/schema.sql a mano en el SQL Editor.
# LORDGYM_DB_DRIVER=supabase
NEXT_PUBLIC_SUPABASE_URL=

# Clave publica. Vale cualquiera de las dos formas que usa Supabase:
#   formato nuevo:   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#   formato clasico: NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta: SOLO servidor, nunca en el cliente ni en el repositorio.
#   formato nuevo:   SUPABASE_SECRET_KEY=sb_secret_...
#   formato clasico: SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_SECRET_KEY=

# --- Driver de persistencia ------------------------------------------------
# "postgres", "supabase" o "local". Si no se define, LORDGYM elige solo:
# PostgreSQL si hay cadena de conexión, y local en tu ordenador si no hay nada.
# LORDGYM_DB_DRIVER=

# Ruta del fichero JSON usado por el driver local.
LORDGYM_DATA_FILE=.lordgym-data/db.json
