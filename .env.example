# ---------------------------------------------------------------------------
# LORDGYM — variables de entorno
# ---------------------------------------------------------------------------
# Sin ninguna variable configurada la app arranca en MODO LOCAL: persistencia en
# disco (.lordgym-data/db.json) con datos demo sembrados. Todo funciona.
# ---------------------------------------------------------------------------

# Clave usada para firmar las cookies de sesión. OBLIGATORIA en producción.
LORDGYM_SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Driver de persistencia: "local" (por defecto) o "supabase".
LORDGYM_DB_DRIVER=local

# Ruta del fichero JSON usado por el driver local.
LORDGYM_DATA_FILE=.lordgym-data/db.json

# Sembrar el equipo de demostración la primera vez (true por defecto).
# Con "false" sólo se carga la biblioteca de ejercicios y las pruebas físicas.
LORDGYM_SEED_DEMO=true

# --- Supabase (obligatorio en Vercel: ver docs/DEPLOY.md) ------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: solo servidor, nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
